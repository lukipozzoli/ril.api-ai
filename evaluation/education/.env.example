# Phoenix es autoalojado: no requiere cuenta ni suscripción de Arize.
PHOENIX_ENDPOINT=http://localhost:6006
# Opcional: fijar la versión de la imagen para reproducir el entorno.
PHOENIX_VERSION=latest
PHOENIX_PORT=6006

# API ADK del sandbox de RIL existente, publicada en el host (incluya /api).
RIL_API_URL=http://localhost:8090/api
RIL_APP_NAME=education_agent
RIL_TIMEOUT_SECONDS=180
# RIL_API_TOKEN=

# Utilice su proyecto y ADC de Google existentes para el simulador y el juez.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
SIMULATOR_MODEL=gemini-2.5-flash
JUDGE_MODEL=gemini-2.5-flash
# Alternativa Gemini Developer API: false arriba y GEMINI_API_KEY abajo.
# GEMINI_API_KEY=
